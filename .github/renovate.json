{
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":semanticCommits",
    ":rebaseStalePrs",
    ":separateMultipleMajorReleases",
    ":separatePatchReleases",
    "github>serubin/flux-infra//.github/renovate/commit.json",
    "github>serubin/flux-infra//.github/renovate/labels.json"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard",
  "suppressNotifications": [
    "prIgnoreNotification"
  ],
  "flux": {
    "managerFilePatterns": [
      "infrastructure/**/*.yaml",
      "apps/**/*.yaml",
      "charts/**/*.yaml",
      "clusters/**/*.yaml"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/^apps/(base|prod|staging)/.*\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "apps/**/*.yaml"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "infrastructure/**/*.yaml",
        "apps/**/*.yaml",
        "charts/**/*.yaml",
        "clusters/**/*.yaml"
      ],
      "matchStrings": [
        "datasource=(?<datasource>\\S+) depName=(?<depName>.*?)\n *version: (?<currentValue>.*)\n"
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}helm{{/if}}"
    }
  ],
  "hostRules": [
    {
      "matchHost": "ghcr.io",
      "username": "serubin",
      "password": "{{ secrets.GHCR_READ_TOKEN }}"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "velero/velero-plugin-for-aws"
      ],
      "allowedVersions": "<=1.14.0",
      "description": "Pinned: v1.14.1's aws-sdk-go-v2 sends an x-amz-tagging header that Backblaze B2 rejects (HTTP 400), breaking all Velero backups. Raise this cap once upstream releases the conditional-Tagging fix (commit 8dbd6b8)."
    },
    {
      "description": "Auto-merge patch updates once CI passes and the release is 3 days old. Releases without a timestamp open but never auto-merge.",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "platformAutomerge": false,
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "internalChecksFilter": "none"
    },
    {
      "matchPackageNames": [
        "ghcr.io/serubin/serubin-net",
        "ghcr.io/serubin/dysautonomia-lounge-website",
        "ghcr.io/serubin/family-tree",
        "ghcr.io/j-paterson/personalwebsite",
        "ghcr.io/anaximand/lemonhope"
      ],
      "automerge": true,
      "matchUpdateTypes": [
        "patch",
        "minor",
        "major"
      ],
      "automergeStrategy": "squash",
      "platformAutomerge": true,
      "minimumReleaseAge": null
    },
    {
      "description": "Critical services: always merged by hand.",
      "matchDepNames": [
        "fluxcd/flux2",
        "kyverno",
        "/^(ghcr\\.io\\/)?kyverno\\//",
        "longhorn",
        "/^(docker\\.io\\/)?longhornio\\//",
        "velero",
        "/^(docker\\.io\\/)?velero\\//",
        "cloudnative-pg",
        "/^ghcr\\.io\\/cloudnative-pg\\//"
      ],
      "automerge": false,
      "minimumReleaseAge": null,
      "addLabels": [
        "renovate/critical"
      ]
    },
    {
      "description": "Critical services: CloudNativePG database clusters, always merged by hand.",
      "matchDepNames": [
        "cluster"
      ],
      "matchRegistryUrls": [
        "/^https:\\/\\/cloudnative-pg\\.io\\/charts\\/?$/"
      ],
      "automerge": false,
      "minimumReleaseAge": null,
      "addLabels": [
        "renovate/critical"
      ]
    }
  ]
}
