{
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":semanticCommits",
    ":rebaseStalePrs",
    ":separateMultipleMajorReleases",
    ":separatePatchReleases",
    "github>serubin/flux-infra//.github/renovate/commit.json",
    "github>serubin/flux-infra//.github/renovate/labels.json"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard",
  "suppressNotifications": [
    "prIgnoreNotification"
  ],
  "flux": {
    "managerFilePatterns": [
      "infrastructure/**/*.yaml",
      "apps/**/*.yaml",
      "charts/**/*.yaml",
      "clusters/**/*.yaml"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/^(apps/(base|prod|staging)|infrastructure)/.*\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "apps/**/*.yaml",
      "infrastructure/**/*.yaml"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "infrastructure/**/*.yaml",
        "apps/**/*.yaml",
        "charts/**/*.yaml",
        "clusters/**/*.yaml"
      ],
      "matchStrings": [
        "datasource=(?<datasource>\\S+) depName=(?<depName>.*?)\n *version: (?<currentValue>.*)\n"
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}helm{{/if}}"
    },
    {
      "customType": "regex",
      "description": "CloudNativePG cluster chart's cluster.imageName: the helm-values manager only reads keys ending in 'image'.",
      "managerFilePatterns": [
        "apps/**/*.yaml"
      ],
      "matchStrings": [
        "imageName: (?<depName>[^\\s:@]+):(?<currentValue>[^\\s@]+)(@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "hostRules": [
    {
      "matchHost": "ghcr.io",
      "username": "serubin",
      "password": "{{ secrets.GHCR_READ_TOKEN }}"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": [
        "infrastructure/backup/cnpg-backup.cronjob.yaml"
      ],
      "matchPackageNames": [
        "postgres"
      ],
      "allowedVersions": "<17",
      "description": "The pg_dump client must stay on the CNPG clusters' Postgres major: a newer client writes dumps the clusters' own pg_restore can't read. Raise this together with the clusters' major."
    },
    {
      "description": "Auto-merge patch updates once CI passes and the release is 1 day old. Releases without a timestamp open but never auto-merge.",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "platformAutomerge": false,
      "minimumReleaseAge": "1 day",
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "internalChecksFilter": "none"
    },
    {
      "description": "kutt's Redis is a cache and the cloudpirates chart ships a minor most weeks: auto-merge minors on the same terms as patches.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/cloudpirates\\/redis$/"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "platformAutomerge": false,
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "internalChecksFilter": "none"
    },
    {
      "description": "Auto-merge minor updates once CI passes and the release is 3 days old. An explicit allowlist naming each chart and image, so a new dependency never joins it by accident.",
      "matchPackageNames": [
        "authentik",
        "/^ghcr\\.io\\/goauthentik\\/server$/",
        "vaultwarden",
        "/^(docker\\.io\\/)?vaultwarden\\/server$/",
        "plausible",
        "/^((docker|ghcr)\\.io\\/)?plausible\\/community-edition$/",
        "lacework-agent",
        "/^(docker\\.io\\/)?lacework\\/datacollector$/",
        "changedetection",
        "/^ghcr\\.io\\/dgtlmoon\\/changedetection\\.io$/",
        "/^ghcr\\.io\\/browserless\\/chromium$/",
        "kutt",
        "/^(docker\\.io\\/)?kutt\\/kutt$/",
        "loki",
        "/^(docker\\.io\\/)?grafana\\/loki$/",
        "/^(docker\\.io\\/)?kiwigrid\\/k8s-sidecar$/",
        "alloy",
        "reviewdog/action-yamllint"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "platformAutomerge": false,
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "internalChecksFilter": "none"
    },
    {
      "description": "Minors that change on-disk state in ways a rollback can't undo (0.x migrations, ClickHouse storage format): always merged by hand, even if a rule above is widened.",
      "matchPackageNames": [
        "nocodb",
        "/^(docker\\.io\\/)?nocodb\\/nocodb$/",
        "/^(docker\\.io\\/)?clickhouse\\/clickhouse-server$/"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": false
    },
    {
      "matchPackageNames": [
        "ghcr.io/serubin/ajd-site",
        "ghcr.io/serubin/serubin-net",
        "ghcr.io/serubin/dysautonomia-lounge-website",
        "ghcr.io/serubin/family-tree",
        "ghcr.io/j-paterson/personalwebsite",
        "ghcr.io/anaximand/lemonhope"
      ],
      "automerge": true,
      "matchUpdateTypes": [
        "patch",
        "minor",
        "major"
      ],
      "automergeStrategy": "squash",
      "platformAutomerge": true,
      "minimumReleaseAge": null
    },
    {
      "description": "Critical services: always merged by hand.",
      "matchDepNames": [
        "fluxcd/flux2",
        "kyverno",
        "/^(ghcr\\.io\\/)?kyverno\\//",
        "longhorn",
        "/^(docker\\.io\\/)?longhornio\\//",
        "velero",
        "/^(docker\\.io\\/)?velero\\//",
        "cloudnative-pg",
        "/^ghcr\\.io\\/cloudnative-pg\\//"
      ],
      "automerge": false,
      "minimumReleaseAge": null,
      "addLabels": [
        "renovate/critical"
      ]
    },
    {
      "description": "Critical services: CloudNativePG database clusters, always merged by hand.",
      "matchDepNames": [
        "cluster"
      ],
      "matchRegistryUrls": [
        "/^https:\\/\\/cloudnative-pg\\.io\\/charts\\/?$/"
      ],
      "automerge": false,
      "minimumReleaseAge": null,
      "addLabels": [
        "renovate/critical"
      ]
    }
  ]
}
